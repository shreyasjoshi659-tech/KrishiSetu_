# Copy to .env and fill in. Without SMTP_* the app runs in TEST mode
# (emails go to a throw-away Ethereal inbox, NOT to real companies).

PORT=3000

# Local development generates a private secret under DATA_DIR when this is empty.
# Production requires JWT_SECRET (at least 32 bytes) from the hosting secret manager.
JWT_SECRET=

# Seeded accounts are blocked by default; never enable them in production.
ALLOW_SEEDED_ACCOUNTS=false

# --- Real outgoing email (Gmail example: enable 2-step verification, then create an "App password") ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yourpool@gmail.com
SMTP_PASS=your-16-char-app-password

# --- Incoming replies from buyers (polled every 60s). Defaults to imap.gmail.com for Gmail ---
# IMAP_HOST=imap.gmail.com
# IMAP_USER=
# IMAP_PASS=

# Disable user+ks-CODE@ reply-to addressing if your provider doesn't support "plus" addresses
# MAIL_PLUS_ADDRESSING=false
